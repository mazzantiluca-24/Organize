{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "organize",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/cal/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "liste", "database_id": "49244671-0b89-4959-8dd1-7206360bf7b0", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
